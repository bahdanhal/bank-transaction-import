<?xml version="1.0"?>
<ruleset name="Custom Standard">
    <description>PSR-12 ruleset for Bank Transaction Import.</description>
    <rule ref="PSR12">
        <!-- Allow snake_case test method names in PHPUnit -->
        <exclude name="PSR1.Methods.CamelCapsMethodName.NotCamelCaps"/>
        <!-- PHP 8.4 property hook compatibility -->
        <exclude name="PSR2.Classes.PropertyDeclaration.Multiple"/>
        <exclude name="PSR2.Classes.PropertyDeclaration.ScopeMissing"/>
        <exclude name="PSR2.Classes.PropertyDeclaration.SpacingAfterType"/>
    </rule>

    <file>app</file>
    <file>tests</file>
    <file>routes</file>

    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>bootstrap/*</exclude-pattern>
    <exclude-pattern>storage/*</exclude-pattern>
    <exclude-pattern>*.blade.php</exclude-pattern>
</ruleset>
